* {
    font-family: "Inter";
    font-size: 10pt;
}

QMainWindow {
    background-color: #E8E5ED;
    border: none;
    margin: 0px;
    padding: 0px;
}

#titleBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E3E7EC;
}

#titleLabTextLabel {
    color: #2E60A9;
    font-size: 13pt;
    font-weight: 700;
}

#titleFileNameLabel {
    color: #33475b;
    font-size: 10pt;
}

#titleSeparatorLabel {
    color: #a7b0ba;
    font-size: 10pt;
}

#titleProjectNameLabelText {
    color: #33475b;
    font-size: 10pt;
}

#titleProjectNameLabelEdit {
    color: #33475b;
    font-size: 10pt;
    background: #F0F2F5;
    border: 1px solid #2E60A9;
    border-radius: 4px;
    padding: 1px 4px;
}

#searchBar {
    background-color: #F0F2F5;
    border: 1px solid #E3E7EC;
    border-radius: 16px;
}

#searchLineEdit {
    background: transparent;
    border: none;
    color: #33475b;
    font-size: 9.5pt;
    padding: 0px;
    margin: 0px;
    min-width: 0px;
    max-width: 16777215px;
    min-height: 0px;
    max-height: 16777215px;
}

#searchIconLabel {
    color: #6f7a86;
    font-size: 30pt;
}

QPushButton {
    background-color: transparent;
    color: #33475b;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 11pt;
    font-weight: 400;
    padding: 6px 4px 8px;
}

QPushButton:hover {
    color: #2E60A9;
}

QPushButton:pressed {
    color: #2E60A9;
}

QPushButton:checked {
    background-color: transparent;
    color: #2E60A9;
    font-weight: 600;
    border-bottom: 2px solid #2E60A9;
    border-radius: 0px;
}

#buttonContainer {
    background-color: #FFFFFF;
    border: 1px solid #E3E7EC;
    border-radius: 10px;
    margin: 8px;
    padding: 6px 16px 2px;
    min-height: 122px;
    max-height: 122px;
}

#buttonContainer QToolButton {
    background-color: transparent;
    color: #2E60A9;
    border: none;
    font-size: 9pt;
    padding: 6px 10px 4px;
}

#buttonContainer QToolButton:checkable {
    border: 2px solid transparent;
    border-radius: 10px;
}

#buttonContainer QToolButton:hover {
    background-color: #EEF3FA;
    border-radius: 10px;
}

#buttonContainer QToolButton:checked {
    background-color: #EEF3FA;
    color: #2E60A9;
    border: 2px solid #2E60A9;
    border-radius: 10px;
}

#buttonContainer QToolButton::menu-button {
    border: none;
    background: transparent;
    width: 16px;
    margin-left: 8px;
}

#buttonContainer QToolButton::menu-button:hover,
#buttonContainer QToolButton::menu-button:pressed,
#buttonContainer QToolButton::menu-button:open {
    border: none;
    background: transparent;
}

#buttonContainer QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center;
    width: 10px;
    height: 10px;
}

#buttonContainer QGroupBox {
    border: none;
    border-left: 1px solid #E3E7EC;
    color: #6f7a86;
    font-size: 9.5pt;
    padding: 0 4px;
    margin: 0;
}

#buttonContainer QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: bottom center;
    padding: 0 8px;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E3E7EC;
    padding: 4px 0px;
}

QMenu::item {
    padding: 8px 24px;
    color: #33475b;
    border-bottom: 1px solid #E3E7EC;
}

QMenu::item:selected {
    background-color: #EEF3FA;
    color: #2E60A9;
}

QToolTip {
    background-color: #FFFFFF;
    color: #33475b;
    border: 1px solid #2E60A9;
    padding: 4px 6px;
}

#resultsPanel {
    background-color: #FFFFFF;
    border-top: 1px solid #E3E7EC;
}

#resultsHeader {
    background-color: #EEF0F4;
}

#resultsTitleLabel {
    color: #33475b;
    font-weight: 600;
    font-size: 9pt;
}

#resultsMenuBtn, #resultsCloseBtn {
    border: none;
    background: transparent;
    color: #6f7a86;
    padding: 2px 6px;
}

#resultsMenuBtn:hover, #resultsCloseBtn:hover {
    background: #E3E7EC;
    border-radius: 4px;
}

#resultsDivider {
    background-color: #2E60A9;
    max-height: 1px;
    border: none;
}

#resultsTable {
    background-color: #FFFFFF;
    border: none;
    gridline-color: #E3E7EC;
    color: #33475b;
}

#explorerPlaceholder {
    color: #8a97a6;
    font-size: 9pt;
    padding: 16px;
}

#explorerTreeWidget {
    background-color: transparent;
    border: none;
    color: #33475b;
    font-size: 9.5pt;
}

#explorerTreeWidget::item {
    padding: 3px 2px;
}

#explorerTreeWidget::item:selected {
    background-color: #EEF3FA;
    color: #2E60A9;
}

#static_sideBar {
    background-color: #FFFFFF;
    border-right: 1px solid #E3E7EC;
}

#static_sideBar QToolButton {
    background-color: transparent;
    border: none;
    padding: 8px;
    border-radius: 6px;
}

#static_sideBar QToolButton:hover {
    background-color: #EEF3FA;
}

QScrollArea {
    border: none;
    background: #E8E5ED;
    padding-left: 4px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 3px 3px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #a267a4ff;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar:vertical:hover {
    margin: 2px 0;
}

QScrollBar::handle:vertical:hover {
    background-color: #a24b7eca;

}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0 2px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #a267a4ff;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color:  #a24b7eca;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}

#trialNavButton {
    background-color: #ffffff;
    color: #2E60A9;
    border: 1px solid #2E60A9;
    border-radius: 8px;
    font-size: 12px;
    padding: 6px 10px;
}

#trialNavButton:hover {
    border: 1.5px solid #2E60A9;
    background-color: #a2c2f3;
    color: #2E60A9;
}

#trialNavButton:pressed {
    border: 1.5px solid #2E60A9;
    background-color: #244c8b;
    color: white;
}

#headerGenerateButton {
    background-color: #2E60A9;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 12px;
    padding: 6px 16px;
}

#headerGenerateButton:hover {
    background-color: #244c8b;
}

#headerGenerateButton:pressed {
    background-color: #1c3d6f;
}

#clearParamsButton {
    border: none;
    background: transparent;
}

#clearParamsButton:hover {
    background-color: #EEF3FA;
    border-radius: 4px;
}

#mainActionButton {
    background-color: transparent;
    color: #EE5D3E;
    border: 1px solid #EE5D3E;
    border-radius: 8px;
    font-weight: bold;
    font-size: 13px;
    padding: 8px 12px;
}

#mainActionButton:hover {
    background-color: #FFE6E0;
    color: #EE5D3E;
    border: 2px solid #EE5D3E;
}

#mainActionButton:pressed {
    background-color: #EE5D3E;
    color: #FFFFFF;
    border: 1.5px solid #EE5D3E;
}

QSpinBox,
QDoubleSpinBox {
    background-color: #FFFFFF;
    color: #2E60A9;
    border: 1px solid transparent;
    border-radius: 8px;
    padding-right: 26px;
    padding-left: 10px;
    padding-top: 2px;
    padding-bottom: 2px;
    min-height: 16px;
    max-height: 21px;
    max-width: 73px;
    font-size: 9pt;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #2E60A9;
    background-color: #FFFFFF;
    color: #2E60A9;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    image: url(:/assets/icons/input/up-btn.png);
    width: 18px;
    height: 10px;
    subcontrol-origin: border;
    subcontrol-position: right top;
    margin: 1px 2px 0 0;
    border: none;
    border-top-right-radius: 8px;
    background: transparent;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    image: url(:/assets/icons/input/down-btn.png);
    width: 18px;
    height: 10px;
    subcontrol-origin: border;
    subcontrol-position: right bottom;
    margin: 0 2px 1px 0;
    border: none;
    border-bottom-right-radius: 8px;
    background: transparent;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: rgba(46, 96, 169, 0.08);
}

QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #9FA8B3;
    background-color: #F5F5F5;
    border: 1px solid #E0E0E0;
}

QComboBox {
    background-color: #FFFFFF;
    color: #2E60A9;
    border: 1px solid transparent;
    border-radius: 8px;
    min-width: 90px;
    max-width: 92px;
    min-height: 16px;
    max-height: 21px;
    font-size: 9pt;
    padding: 2px 28px 2px 8px;
}

QComboBox:focus {
    border: 1px solid #2E60A9;
    background-color: #FFFFFF;
    color: #2E60A9;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: none;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    background: transparent;
}

QComboBox::down-arrow {
    image: url(:/assets/icons/input/down-btn.png);
    width: 14px;
    height: 10px;
}

QComboBox:hover {
    background-color: #F9FBFF;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #2E60A9;
    border: 1px solid #2E60A9;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #2E60A9;
    selection-color: #FFFFFF;
    outline: none;
}

QComboBox QAbstractItemView::item {
    border-bottom: 1px solid #E8E8E8;
}
QComboBox QAbstractItemView::item:last {
    border: none;
}

QComboBox:disabled {
    background-color: #F0F0F0;
    color: #A0A0A0;
    border: 1px solid #D0D0D0;
    border-radius: 8px;
    padding: 4px 28px 4px 8px;
}

QComboBox::drop-down:disabled {
    background: transparent;
}

QComboBox::down-arrow:disabled {
    image: url(:/assets/icons/input/down-btn-gray.png);
}

QComboBox QAbstractItemView:disabled {
    background-color: #F0F0F0;
    color: #A0A0A0;
    border: 1px solid #D0D0D0;
    border-radius: 6px;
    padding: 4px;
}

QComboBox QAbstractItemView::item:disabled {
    color: #A0A0A0;
    background-color: transparent;
    border-bottom: 1px solid #E8E8E8;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid #2E60A9;              
    background: white;
    margin-right: 6px;
}

QCheckBox::indicator:checked {
    background-color: transparent ;              
    image: url(:/assets/icons/input/check-btn.png);
    background-position: center;
    background-repeat: no-repeat;
}

QCheckBox::indicator:hover {
    background-color: rgba(46, 96, 169, 0.1);
}

QCheckBox::indicator:disabled {
    border: 2px solid #C5C9D1;
    background: #F2F2F2;
}

QCheckBox {
    color: #2E60A9;
    spacing: 6px;
    font-size: 10pt;
}

QListWidget {
    background: transparent;
    border: none;
    outline: none;
}

QListWidget::item {
    padding: 4px 6px;
    color: #2E60A9;
}

QListWidget::item:hover {
    background: rgba(46, 96, 169, 0.06);
}

QListWidget::item:selected {
    background: rgba(46, 96, 169, 0.14);
    color: #2E60A9;
}

QListView::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 1px solid #2E60A9;
    background: #FFFFFF;
    margin-right: 6px;
    margin-left: 4px;
}

QListView::indicator:checked {
    background: transparent;
    image: url(:/assets/icons/input/check-btn.png);
    background-position: center;
    background-repeat: no-repeat;
}

QListView::indicator:hover {
    background: rgba(46, 96, 169, 0.12);
}

QListView::indicator:disabled {
    border: 1px solid #C5C9D1;
    background: #F2F2F2;
    opacity: 0.6;
}

QLineEdit {
    background-color: #FFFFFF;
    color: #2E60A9;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 8px;
    selection-background-color: #2E60A9;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 1px solid #2E60A9;
    background-color: #FFFFFF;
    color: #2E60A9;
}

QLineEdit:!focus {
    color: #2E60A9;
}

QLineEdit[placeholderText] {
    color: #2E60A9;
}

QLineEdit:hover {
    background-color: #F9FBFF;
}

QLineEdit:disabled {
    color: #9FA8B3;
    background-color: #F5F5F5;
    border: 1px solid #E0E0E0;
}

QLineEdit {
    background-color: #FFFFFF;
    color: #2E60A9;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 9pt;
    min-height: 18px;
    max-height: 21px;
    max-width: 73px;
    padding: 3px 6px;
    selection-background-color: #2E60A9;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 1px solid #2E60A9;
    background-color: #FFFFFF;
}

QLineEdit:hover {
    background-color: #F9FBFF;
}

QLineEdit[placeholderText] {
    color: #A0A7B5;
}

QLineEdit:disabled {
    color: #9FA8B3;
    background-color: #F3F3F3;
    border: 1px solid #E0E0E0;
}

QLabel[variant="title"] {
    font-size: 10pt;
    font-weight: 600;
    color: #2E60A9;
    padding-top: 2px;
}

QLabel[variant="subtitle"] {
    font-size: 8.5pt;
    font-weight: 600;
    color: #2E60A9;
    padding-top: 2px;
}

QLabel[variant="input"] {
    font-size: 8pt;
    color: #2E60A9;
    letter-spacing: 0.2px;
}

QFrame[role="section-divider"] {
    background: #2E60A9;
    max-height: 2px;
    min-height: 2px;
    border: none;
}

QFrame[role="divider"] {
    background: #2E60A9;
    max-height: 1px;
    min-height: 1px;
    border: none;
}

#spinnerDialog {
    background-color: rgba(0, 0, 0, 160);
    border-radius: 12px;
}

#spinnerDialog QLabel {
    color: white;
    font-size: 10pt;
    font-weight: 500;
    text-align: center;
}

#spinnerDialog QProgressBar {
    border: none;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    height: 8px;
}

#spinnerDialog QProgressBar::chunk {
    background-color: #2E60A9;
    border-radius: 8px;
}

#spinnerDialog QLabel[role="spinner-gif"] {
    qproperty-alignment: AlignCenter;
    margin-bottom: 6px;
}

#notificationCard {
    border-radius: 6px;
    border: 1px solid #C9D6EA;
    border-left: 5px solid #2E60A9;
    background-color: #EEF3FB;
}

#notificationCard[severity="warning"] {
    border: 1px solid #F0D9A8;
    border-left: 5px solid #D9822B;
    background-color: #FFF6E5;
}

#notificationCard[severity="error"] {
    border: 1px solid #F1C2C2;
    border-left: 5px solid #C0392B;
    background-color: #FDECEC;
}

#notificationIcon {
    font-size: 12pt;
    font-weight: 700;
    color: #2E60A9;
    background: transparent;
}

#notificationIcon[severity="warning"] { color: #D9822B; }
#notificationIcon[severity="error"]   { color: #C0392B; }

#notificationTitle {
    font-weight: 700;
    color: #2E60A9;
    background: transparent;
}

#notificationTitle[severity="warning"] { color: #9A5B12; }
#notificationTitle[severity="error"]   { color: #922B21; }

#notificationMessage {
    color: #33475b;
    background: transparent;
}

#notificationClose {
    border: none;
    background: transparent;
    color: #6B7785;
    font-size: 9pt;
    padding: 0px 4px;
}

#notificationClose:hover {
    color: #1F2D3D;
}

QStatusBar[severity="warning"] { color: #9A5B12; }
QStatusBar[severity="error"]   { color: #C0392B; font-weight: 600; }

#titleTrialLabel {
    color: #2E60A9;
    font-size: 10pt;
    font-weight: 600;
    padding: 1px 8px;
    border-radius: 4px;
    background-color: #EEF3FB;
}

#titleTrialLabel[severity="warning"] {
    color: #9A5B12;
    background-color: #FFF6E5;
}

#cursorReadoutLabel {
    color: #33475b;
    font-family: "Consolas", "Inter";
    padding: 0px 8px;
}

#cursorOverlayLabel {
    color: #1F2D3D;
    background-color: rgba(255, 255, 255, 215);
    border: 1px solid #C9D6EA;
    border-radius: 4px;
    padding: 2px 6px;
    font-family: "Consolas", "Inter";
    font-size: 9pt;
}
